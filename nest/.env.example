# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=3001

# Simulated "today" (YYYY-MM-DD) so the mock data lines up; leave empty for the real date.
# Keep it the same as TODAY in nuxt/.env
TODAY=2026-05-15

# Browser origins allowed to call the API, comma-separated (the Nuxt app)
CORS_ORIGIN=http://localhost:3000

# HS256 secret, node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# "iss" claim on issued access tokens
JWT_ISSUER=susi-air

# Token lifetimes: a number with a unit (ms, s, m, h, d, w)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
