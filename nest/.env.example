# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=3001

# HS256 secret, node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# "iss" claim on issued access tokens
JWT_ISSUER=susi-air

# Token lifetimes: a number with a unit (ms, s, m, h, d, w)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
